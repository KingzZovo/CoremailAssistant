# 论客邮箱 (Coremail) 账户凭证与环境变量配置
# 请复制为 .env 文件后修改对应值，请勿提交包含真实密码的 .env 文件至 GitHub

COREMAIL_SERVER=mail.example.com
COREMAIL_IMAP_PORT=993
COREMAIL_SMTP_PORT=465
COREMAIL_USERNAME=your_account@example.com
COREMAIL_PASSWORD=your_password_or_auth_code

# 应用基础配置
COREMAIL_POLL_INTERVAL=60
COREMAIL_LOG_LEVEL=INFO
